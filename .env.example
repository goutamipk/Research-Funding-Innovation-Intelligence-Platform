# Application Environment Configuration
APP_NAME="Research Funding Recommendation API"
PROJECT_NAME="Research Funding Recommendation API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Configuration
HOST="0.0.0.0"
PORT=8000
WORKERS=1

# API Versioning Prefix
API_PREFIX="/api/v1"
API_V1_STR="/api/v1"

# Paths
MODEL_PATH="app/ml/saved_models/recommender.pkl"
DATASET_PATH="dataset/4_Research projects start date 2021 onwards.csv"

# CORS Configuration (JSON array string or comma-separated URLs)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# ML Model Settings
MAX_RECOMMENDATIONS=10
